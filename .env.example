# Copy to .env.local. Keep real credentials out of Git and the browser.
APP_MODE=sample
PORT=3000
HOST=127.0.0.1
# Set APP_MODE=live only after configuring both providers.
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
# Optional route service. Live timing requires this key.
GOOGLE_MAPS_API_KEY=
# In production, set a random secret of at least 32 characters.
COOKIE_SECRET=
# Exact public origin in production, e.g. https://dayriff.example
APP_ORIGIN=
MAX_DAILY_PLANS=100
MAX_DAILY_LOOKUPS=2000

# Local durable data stays in this ignored private directory.
# Production must use Firestore with the Cloud Run service account (no key files).
STORAGE_BACKEND=file
STORAGE_DIRECTORY=.private/state
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
# Anonymous trips expire after 30 days without activity.
# Provider-attempt budgets are shared across all production instances.
MAX_DAILY_OPENAI_REQUESTS=400
MAX_DAILY_QLOO_REQUESTS=2000
MAX_DAILY_ROUTES_REQUESTS=300
MAX_SESSION_DAILY_PLANS=30
