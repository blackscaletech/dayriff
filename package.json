{
  "name": "dayriff",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts --dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json && node scripts/compress.mjs",
    "start": "node --env-file-if-exists=.env.local dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "qa:live": "tsx scripts/check-live-conversations.ts",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/middie": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.6",
    "@google-cloud/firestore": "9.3.1",
    "fastify": "^5.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tz-lookup": "^6.1.25",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/tz-lookup": "^6.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
